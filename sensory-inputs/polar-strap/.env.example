# MQTT broker
MQTT_HOST="hri.thecraceatree.com"
MQTT_PORT=443
MQTT_USE_WSS=true
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_TOPIC="telemetry/polar"

# BLE address of the sensor (optional). Leave empty to connect to the first Polar device found.
# Find it with: python polar_reader.py --scan
POLAR_DEVICE_ADDRESS=""
