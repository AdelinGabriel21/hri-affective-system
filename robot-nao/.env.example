# NAO robot
# Virtual robot (Choregraphe): keep NAO_IP=127.0.0.1 and leave NAO_PORT empty;
# run.sh finds the port Choregraphe picked (it changes every time it starts).
# Physical robot: its IP (press the chest button once, it says it) and NAO_PORT=9559.
NAO_IP="127.0.0.1"
NAO_PORT=""
NAO_DEVICE_NAME="nao_virtual"

# MQTT broker
MQTT_HOST="hri.thecraceatree.com"
MQTT_PORT=443
